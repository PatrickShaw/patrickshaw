# Took some settings from:
# https://www.youtube.com/watch?v=aolI_Rz0ZqY
# Some notes: git maintenance start is great
# 

[user]
	email = mail@patrickshaw.me
	name = Patrick Shaw
	# SSH signing key. `ssh-keygen -Y sign` is used under the hood, so this is just
	# the public key path — no separate signing subkey to manage.
	# signingkey = ~/.ssh/id_ed25519.pub

[column]
  # Puts branches in columns
	ui = auto

[branch]
  # Last comitted at the bottom of list
  sort = committerdate

[tag]
  # Sort tags by semver rather than lexically, so v10 comes after v9
  sort = version:refname

[help]
  # Wait 1 second (units are deciseconds) before running the corrected command,
  # so a typo'd command is recoverable with Ctrl-C
  autocorrect = 10

[push]
	autoSetupRemote = true

[init]
	templatedir = ~/.git-templates
	defaultBranch = main

[commit]
	# Signing is SSH-based now (see [gpg] below) rather than GPG, which removes the
	# agent/pinentry/expiry hassle that got this turned off in the first place.
	gpgsign = true

[core]
    pager = delta
	# See: https://www.git-tower.com/blog/git-performance/
	# See: https://www.youtube.com/watch?v=aolI_Rz0ZqY
	# Actually decided to do this based on a GitHub blog post about it
    fsmonitor = true
	# See https://www.git-tower.com/blog/git-performance/
	# See: https://www.youtube.com/watch?v=aolI_Rz0ZqY
    untrackedcache = true
	# See: https://www.git-tower.com/blog/git-performance/
	# See: https://www.youtube.com/watch?v=aolI_Rz0ZqY
	commitgraph = true
	excludesfile = ~/.gitignore_global

[fetch]
  # See: https://www.git-tower.com/blog/git-performance/
	# Explained here: https://www.youtube.com/watch?v=aolI_Rz0ZqY
  writeCommitGraph = true

	# Unfortunately this gets in the way more than its convenient with massive monorepos - Even thought that's why I enabled it in the first place. Too many lock conflicts end up happening
	# prune = true
	# pruneTags = true
	# quiet = true

[feature]
    # Optimises for lots of files
	# See: https://www.git-tower.com/blog/git-performance/
    manyFiles = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
    side-by-side = true
    line-numbers = true
    # Makes file paths / line numbers clickable in terminals that support OSC 8
    hyperlinks = true

# Syntax-aware (tree-sitter based) diffs, as an opt-in alongside delta.
# Usage: `git dft` / `git dft <commit>` / `git difftool --tool=difftastic`
[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"
[difftool]
    prompt = false
[pager]
    difftool = true
   
[merge]
		# Giving zdiff3 a go over diff3
    conflictstyle = zdiff3

[diff]
    colorMoved = dimmed-zebra
	# See: https://luppeng.wordpress.com/2020/10/10/when-to-use-each-of-the-git-diff-algorithms/
	algorithm = histogram
	renames = copies

[rerere]
# Auto resolves conflicts if I specified how to resolve them before. Could be risky. Added in 2023-07-20. Will give it a go
# 2025-01-27 I don't think I've ran into any issues recently with bugs in my merging history. Not anymore than usual anyway. Keeping this
enabled = true
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[gpg]
	# git 2.34+ can sign with SSH keys instead of GPG
	# format = ssh
	# Kept for the rollback path (`git config --global gpg.format openpgp`)
	# program = /run/current-system/sw/bin/gpg

[gpg "ssh"]
	# Only needed to *verify* signatures (`git log --show-signature`); signing works
	# without it. Format is one `<email> <keytype> <key>` line per signer, e.g.
	#   mail@patrickshaw.me ssh-ed25519 AAAAC3Nza...
	allowedSignersFile = ~/.ssh/allowed_signers
[pull]
	rebase = false

[rebase]
	autoStash = true
	# Rewrites any other local branches that pointed at the commits being rebased,
	# so stacked branches stop drifting out of sync. Added in git 2.38.
	# See: https://andrewlock.net/working-with-stacked-branches-in-git-is-easier-with-update-refs/
	updateRefs = true

[alias]
c = "commit -m"
f = "!$HOME/personal/code-snippets/git/fetch-important.sh"

# Syntax-aware diff via difftastic
dft = "-c diff.external=difft diff"

# Fetch all
fa = "fetch"

# Rebase origin
rbo = "!git f && git rebase -i origin/main"

cull-storage = "!git pull --depth=1 --rebase && git reflog expire --expire=now --all && git gc --prune=now"
